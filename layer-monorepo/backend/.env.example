# LAYER Backend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Database (Supabase PostgreSQL)
# =============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=

# =============================================================================
# Redis (Upstash)
# =============================================================================
# Format: redis://default:password@host:port
REDIS_URL=

# =============================================================================
# Application Settings
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (set to false in production)
DEBUG=true

# Secret key for JWT and other security features
SECRET_KEY=

# =============================================================================
# Optional: Local Development Overrides
# =============================================================================
# Use SQLite for local development (uncomment to enable)
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Use fakeredis for local development (set in code, not env)
